{
  "//": "跨语言定价向量。中台（TypeScript + decimal.js）与 bifu-payment-sdk（Go + shopspring/decimal）读同一份文件、断言同一批期望值。算价在 SDK 侧发生，所以两套实现必须一致——这份文件就是钉子。改它等于改定价口径，两边的用例会同时红。",
  "algorithm": "入金：成交价 = 底价 × (1 − 点差/10000)（FIXED 时为 底价 − 点差）；出金反向。毛额 = 法币金额 × 成交价，按 amountPrecision 取整；手续费 = feeFixed + 毛额 × feeRatePercent/100，同样取整；入金净额 = 毛额 − 手续费，出金净额 = 毛额 + 手续费。",
  "vectors": [
    {
      "name": "BFT 实测价 · 入金 · 30bps · 手续费 1+0.1%",
      "why": "最典型的一笔：真实渠道价取倒数后的入金报价",
      "input": {
        "direction": "DEPOSIT",
        "basePrice": "0.1479289940828402366863905325443786982249",
        "fiatAmount": "7200",
        "spreadType": "BPS",
        "spreadValue": "30",
        "feeFixed": "1",
        "feeRatePercent": "0.1",
        "pricePrecision": 6,
        "amountPrecision": 2,
        "rounding": "HALF_UP"
      },
      "expected": {
        "dealPrice": "0.147485",
        "grossCrypto": "1061.89",
        "fee": "2.06189",
        "netCrypto": "1059.83",
        "spreadRevenue": "3.2",
        "platformRevenue": "5.26189"
      }
    },
