        "direction": "DEPOSIT",
        "basePrice": "0.1479289940828402366863905325443786982249",
        "fiatAmount": "7200",
        "spreadType": "BPS",
        "spreadValue": "30",
        "feeFixed": "1",
        "feeRatePercent": "0.1",
        "pricePrecision": 6,
        "amountPrecision": 2,
        "rounding": "HALF_UP"
      },
      "expected": {
        "dealPrice": "0.147485",
        "grossCrypto": "1061.89",
